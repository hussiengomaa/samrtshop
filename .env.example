# GEMINI_API_KEY: Required for Gemini AI API calls and Google Search Grounding.
# Automatically provided in Google AI Studio environment or via your Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPAPI_API_KEY: Optional external provider key for live Google Shopping Egypt search.
# If omitted or empty, the SerpApi adapter safely reports status as 'not_configured'.
SERPAPI_API_KEY="your_serpapi_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# CACHE_TTL_MINUTES: Cache duration for external search queries (default 60 minutes)
CACHE_TTL_MINUTES=60

# Provider enable/disable toggles
SERPAPI_ENABLED=true
GEMINI_GROUNDING_ENABLED=true
